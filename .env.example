# ------------------------------------------------------------------
# FORNO — environment variables (all optional)
# Copy to `.env.local` for local dev, or set in the Vercel dashboard.
# The site works with sensible demo defaults if these are unset.
# ------------------------------------------------------------------

# Canonical production URL — used for metadata, OG tags, sitemap & robots.
NEXT_PUBLIC_SITE_URL="https://forno-queretaro.vercel.app"

# WhatsApp number for reservation / order CTAs (country + area + number, digits only).
NEXT_PUBLIC_WHATSAPP_NUMBER="5214421234567"

# Phone number shown to users and used in tel: links.
NEXT_PUBLIC_PHONE_DISPLAY="+52 442 123 4567"
NEXT_PUBLIC_PHONE_RAW="+524421234567"
